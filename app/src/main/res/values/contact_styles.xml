<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="surface">#282330</color>
    <color name="button_fill">#7750BC</color>
    <color name="primary">#A887F8</color>
    <color name="primary_text">#D1BCFF</color>
    <color name="background">#19181E</color>
    <color name="ink">#F4F0FC</color>
    <color name="muted">#B9B1C8</color>
    <color name="soft_purple">#38294E</color>
    <color name="stroke">#4C3B64</color>
    <color name="danger">#F4A8C0</color>
    <color name="gold">#C8ADFF</color>

    <style name="ScreenTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="FieldLabel" parent="BodyText">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>
    <style name="Avatar">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="BackButton" parent="SecondaryButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="SectionLabel" parent="BodyText">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>
