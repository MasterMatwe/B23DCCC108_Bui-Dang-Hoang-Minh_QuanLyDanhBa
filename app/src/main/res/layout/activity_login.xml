<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_phone" android:background="@drawable/bg_avatar" android:padding="12dp" android:importantForAccessibility="no"/>
            <TextView style="@style/SectionLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/brand"/>
        </LinearLayout>
        <View android:layout_width="40dp" android:layout_height="4dp" android:background="@color/primary" android:layout_marginTop="48dp"/>
        <TextView style="@style/ScreenTitle" android:text="@string/login_title" android:textSize="40sp" android:layout_marginTop="20dp"/>
        <TextView style="@style/BodyText" android:text="@string/login_subtitle" android:textSize="15sp" android:layout_marginTop="12dp" android:layout_marginBottom="36dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_card">
            <TextView style="@style/SectionLabel" android:text="@string/login_form_title"/>
            <TextView style="@style/FieldLabel" android:text="@string/username_label"/>
            <EditText style="@style/InputField" android:id="@+id/username" android:hint="@string/username_hint" android:inputType="text" android:autofillHints="username" android:imeOptions="actionNext"/>
            <TextView style="@style/FieldLabel" android:text="@string/password_label"/>
            <EditText style="@style/InputField" android:id="@+id/password" android:hint="@string/password_hint" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone"/>
            <TextView style="@style/BodyText" android:id="@+id/login_error" android:text="@string/login_failed" android:textColor="@color/danger" android:layout_marginTop="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
            <Button style="@style/PrimaryButton" android:id="@+id/login_button" android:text="@string/login" android:layout_marginTop="24dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
