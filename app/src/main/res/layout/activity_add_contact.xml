<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:paddingHorizontal="24dp" android:paddingVertical="16dp">
        <Button style="@style/BackButton" android:id="@+id/back_button" android:text="@string/symbol_back" android:contentDescription="@string/back"/>
        <TextView style="@style/ScreenTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/add_contact" android:textSize="22sp" android:layout_marginStart="16dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" android:layout_marginHorizontal="24dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="24dp" android:focusableInTouchMode="true">
            <TextView style="@style/BodyText" android:text="@string/add_subtitle" android:layout_marginTop="20dp"/>
            <TextView style="@style/BodyText" android:text="@string/required_hint" android:textSize="12sp" android:layout_marginTop="6dp"/>
            <TextView style="@style/SectionLabel" android:text="@string/section_basic" android:layout_marginTop="28dp" android:layout_marginBottom="14dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">
            <TextView style="@style/FieldLabel" android:text="@string/full_name_label" android:layout_marginTop="0dp"/>
            <EditText style="@style/InputField" android:id="@+id/full_name" android:hint="@string/full_name_hint" android:inputType="textPersonName|textCapWords" android:autofillHints="personName" android:imeOptions="actionNext"/>
            <TextView style="@style/FieldLabel" android:text="@string/phone_label"/>
            <EditText style="@style/InputField" android:id="@+id/phone" android:hint="@string/phone_hint" android:inputType="phone" android:autofillHints="phone" android:imeOptions="actionNext"/>
            <TextView style="@style/BodyText" android:text="@string/phone_helper" android:textSize="12sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <TextView style="@style/SectionLabel" android:text="@string/section_personal" android:layout_marginTop="28dp" android:layout_marginBottom="14dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">
            <TextView style="@style/FieldLabel" android:text="@string/group_label" android:labelFor="@+id/group" android:layout_marginTop="0dp"/>
            <Spinner android:id="@id/group" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_spinner" android:paddingStart="12dp" android:paddingEnd="40dp" android:spinnerMode="dropdown"/>
            <TextView style="@style/FieldLabel" android:text="@string/gender_label" android:labelFor="@+id/gender"/>
            <RadioGroup android:id="@id/gender" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:checkedButton="@+id/gender_male">
                <RadioButton android:id="@id/gender_male" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/male" android:textColor="@color/ink"/>
                <RadioButton android:id="@+id/gender_female" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/female" android:textColor="@color/ink"/>
                <RadioButton android:id="@+id/gender_other" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/other" android:textColor="@color/ink"/>
            </RadioGroup>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" android:layout_marginVertical="12dp"/>
            <CheckBox android:id="@+id/favorite" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/add_favorite" android:textColor="@color/primary_text"/>
            </LinearLayout>
            <TextView style="@style/SectionLabel" android:text="@string/section_note" android:layout_marginTop="28dp" android:layout_marginBottom="14dp"/>
            <EditText style="@style/InputField" android:id="@+id/note" android:hint="@string/note_hint" android:inputType="textMultiLine|textCapSentences" android:singleLine="false" android:minLines="4" android:gravity="top|start" android:importantForAutofill="no"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingVertical="16dp">
        <Button style="@style/PrimaryButton" android:id="@+id/save_button" android:text="@string/save_contact"/>
    </LinearLayout>
</LinearLayout>
